//@version=5
strategy("ORB v8.4 复刻 (5min)", shorttitle="ORB v8.4", overlay=true,
     initial_capital=25000,
     default_qty_type=strategy.fixed,
     commission_type=strategy.commission.cash_per_contract,
     commission_value=0.5,
     slippage=0)

// ============================================================================
// 复刻 orb_backtes_v8_4.py（NQ 5分钟 ORB）
//   区间 : 9:00-9:30 盘前高低点（需图表含 ETH 扩展时段数据）
//   入场 : 9:30-10:10 逐根收盘突破区间 → 收盘>区间高做多 / 收盘<区间低做空，每日一次
//   止损 : ATR止损% × 前一日14日ATR（v8.4 代码实际值 7.5%，注释写 5%；见输入说明）
//   保本 : 浮盈达 N×R → 止损拉到「保本 + 缓冲 tick」
//   平仓 : 收盘（15:55）
//   仓位 : floor( equity × 风险% / (止损点数 × 乘数) )，上限 maxQty，乘数自动取每点价值
// ============================================================================

// ---- 区间与入场 ----
rangeStart = input.string("0900", "区间开始 (HHmm)", group="区间与入场")
rangeEnd   = input.string("0930", "区间结束 (HHmm)", group="区间与入场")
entryStart = input.string("0930", "入场开始 (HHmm)", group="区间与入场")
entryEnd   = input.string("1010", "入场结束 (HHmm)", group="区间与入场")
eodTime    = input.string("1555", "收盘平仓时间 (HHmm)", group="区间与入场")
tz         = input.string("America/New_York", "时区", group="区间与入场")

// ---- 止损 ----
atrFrac = input.float(7.5, "ATR 止损百分比 %（v8.4实际=7.5，注释写5）", minval=0.0, step=0.5, group="止损")
atrLen  = input.int(14, "ATR 周期", minval=1, group="止损")
atrTf   = input.timeframe("D", "ATR 周期来源（默认日线）", group="止损")
tick    = input.float(0.25, "最小变动价位 tick", minval=0.0001, group="止损")
beR     = input.float(4.0, "拉保本倍数 R", minval=0.0, step=0.5, group="止损")
beTicks = input.int(5, "保本缓冲 tick 数", minval=0, group="止损")

// ---- 仓位 ----
riskPct = input.float(0.8, "每笔风险比例 %（v8.4实际=0.8，注释写1）", minval=0.0, step=0.1, group="仓位")
maxQty  = input.int(300, "最大手数上限", minval=0, group="仓位")
multOv  = input.float(0.0, "乘数覆盖（0=自动 syminfo.pointvalue）", minval=0.0, group="仓位")

// ---- 显示 ----
showRange = input.bool(true, "显示 9:00-9:30 区间高低点", group="显示")
showStop  = input.bool(true, "显示当前止损价", group="显示")

// ---- 工具：HHmm 字符串 → 当日分钟数 ----
f_min(_s) =>
    h = str.tonumber(str.substring(_s, 0, 2))
    m = str.tonumber(str.substring(_s, 2, 4))
    h * 60 + m

barMin   = hour(time, tz) * 60 + minute(time, tz)
dayId    = year(time, tz) * 10000 + month(time, tz) * 100 + dayofmonth(time, tz)
isNewDay = ta.change(dayId) != 0

inRange = barMin >= f_min(rangeStart) and barMin < f_min(rangeEnd)
inEntry = barMin >= f_min(entryStart) and barMin < f_min(entryEnd)
atEod   = barMin >= f_min(eodTime)

// ---- 每日 9:00-9:30 区间高低点 ----
var float rngHi = na
var float rngLo = na
if isNewDay
    rngHi := na
    rngLo := na
if inRange
    rngHi := na(rngHi) ? high : math.max(rngHi, high)
    rngLo := na(rngLo) ? low : math.min(rngLo, low)

// ---- 前一日 14 日 ATR（固定，无未来函数）----
prevAtr = request.security(syminfo.tickerid, atrTf, ta.atr(atrLen)[1])

// ---- 止损点数 = ATR止损% × 前一日ATR，按 tick 取整（至少 1 tick）----
frac    = atrFrac / 100.0
stopPts = math.max(tick, math.round(frac * prevAtr / tick) * tick)

// ---- 仓位计算 ----
m    = multOv > 0 ? multOv : syminfo.pointvalue
perU = stopPts * m
qtyF = perU > 0 ? strategy.equity * (riskPct / 100.0) / perU : na
if not na(qtyF) and maxQty > 0
    qtyF := math.min(qtyF, maxQty)
qty = na(qtyF) ? na : int(math.floor(qtyF))

// ---- 每日一次入场标记 ----
var bool enteredToday = false
if isNewDay
    enteredToday := false

// ---- 持仓状态 ----
var float entryPx = na
var float rPts    = na
var float slPx    = na
var bool  beDone  = false

canTrade = not na(qty) and qty >= 1

if inEntry and not enteredToday and not na(rngHi) and not na(rngLo) and canTrade
    if close > rngHi
        strategy.entry("L", strategy.long, qty)
        enteredToday := true
        entryPx := close
        rPts := stopPts
        slPx := close - rPts
        beDone := false
    else if close < rngLo
        strategy.entry("S", strategy.short, qty)
        enteredToday := true
        entryPx := close
        rPts := stopPts
        slPx := close + rPts
        beDone := false

// ---- 拉保本（浮盈达 beR 倍 R，用最高/最低价触及判断）----
if strategy.position_size > 0 and not beDone and high >= entryPx + beR * rPts
    slPx := entryPx + beTicks * tick
    beDone := true
if strategy.position_size < 0 and not beDone and low <= entryPx - beR * rPts
    slPx := entryPx - beTicks * tick
    beDone := true

// ---- 止损（盘中触发；收盘那根不再挂止损，直接平仓）----
if strategy.position_size > 0 and not atEod
    strategy.exit("XL", from_entry="L", stop=slPx)
if strategy.position_size < 0 and not atEod
    strategy.exit("XS", from_entry="S", stop=slPx)

// ---- 收盘平仓 ----
if atEod and strategy.position_size != 0
    strategy.close_all(comment="EOD")

// ---- 可视化 ----
plot(showRange ? rngHi : na, "区间高", color=color.new(color.green, 0), style=plot.style_linebr)
plot(showRange ? rngLo : na, "区间低", color=color.new(color.red,   0), style=plot.style_linebr)
plot(showStop and strategy.position_size != 0 ? slPx : na, "止损价", color=color.new(color.orange, 0), style=plot.style_linebr, linewidth=2)
